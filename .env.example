# Copie para .env.local e preencha

# Supabase (obrigatório para persistir e listar leads no admin)
# Aceita também os nomes da integração Vercel (NEXT_SUPABASE_*)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente server — nunca expor no client
SUPABASE_SERVICE_ROLE_KEY=
# Alternativas da integração Supabase na Vercel:
# NEXT_SUPABASE_URL=
# NEXT_SUPABASE_SERVICE_ROLE_KEY=
# NEXT_SUPABASE_ANON_KEY=

# OpenAI (opcional — refina cálculo + texto; sem chave usa só heurística)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# WhatsApp oficial Impulso Criativo
NEXT_PUBLIC_WHATSAPP_URL=https://api.whatsapp.com/send/?phone=5551989099973&text=Gostaria+conhecer+a+Impulso+Criativo&type=phone_number&app_absent=0

# Painel admin (/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=impulso2026
ADMIN_SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio
